; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Print Shop Tycoon"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/game/game.gd"
Screens="*res://scripts/game/screens.gd"
DevShot="*res://scripts/dev/dev_shot.gd"
DevAutoplay="*res://scripts/dev/dev_autoplay.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

scene={
"import_script/path": "res://scripts/import/palette_post_import.gd"
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
